# Supabase (Project Settings > API) — camada gratuita
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# URL pública do app (usada nos e-mails de confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Etapa 2 (Inteligência) — configurar como SECRETS no painel da Cloudflare, nunca aqui ---
# SUPABASE_SERVICE_ROLE_KEY=      # processador de agentes (ignora RLS) — NUNCA expor no navegador
# GEMINI_API_KEY=                 # Google AI Studio, camada gratuita
# GEMINI_MODEL=gemini-3.5-flash-lite   # opcional (padrão já é este)
# AGENTS_CRON_SECRET=             # texto aleatório longo; protege /api/agents/run (Cron Trigger)
# ML_CLIENT_ID=                   # opcional: app do Mercado Livre Developers (mais vendidos reais)
# ML_CLIENT_SECRET=               # opcional

# --- Próximas etapas ---
